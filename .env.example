# Database
DATABASE_URL=
DATABASE_URL_TEST=

# Redis — sessions, BullMQ queues, quote cache
REDIS_URL=

# Object storage (S3 API — MinIO locally, MinIO on the node in production)
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_KYC=
S3_BUCKET_INSPECTIONS=
S3_BUCKET_CONTRACTS=
S3_BUCKET_VEHICLES=

# Application
SESSION_SECRET=
NOTIFY_DRIVER=console
TZ=UTC

# HMAC pepper for OTP code hashes (apps/web/src/auth/otp.ts). Must be at least 32
# characters and never committed. Generate one with:
#   openssl rand -hex 32
OTP_PEPPER=
