node_modules/
.next/
out/
build/
dist/
.turbo/

# Secrets — broad by design. Anything ending .env, in any case, anywhere.
.env
.env.*
*.env
*.ENV
*.Env
!.env.example

# Credentials
*.pem
*.key
*credentials*
*secret*
*token*
.netrc

# ...but never let those broad patterns swallow generated migrations. drizzle-kit
# names files with random adjective_noun pairs, and "0005_secret_spot.sql" really
# happened. A silently untracked migration means a fresh clone builds the wrong schema.
!packages/db/migrations/**

.DS_Store
*.log
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

coverage/
.expo/
*.tsbuildinfo
.vercel

# Embedded Postgres scratch data directory (packages/db test harness fallback)
.embedded-pg/
