{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_URL_TEST",
    "REDIS_URL",
    "S3_ENDPOINT",
    "S3_PUBLIC_URL",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET_KYC",
    "S3_BUCKET_INSPECTIONS",
    "S3_BUCKET_CONTRACTS",
    "S3_BUCKET_VEHICLES",
    "SESSION_SECRET",
    "NOTIFY_DRIVER",
    "NODE_ENV",
    "TZ",
    "CI"
  ],
  "tasks": {
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^build"] },
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "lint": {}
  }
}
